# Runtime secrets only. Never commit .env.local.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional on Vercel: defaults to the current HTTPS host + this callback path.
# Add the exact callback URL to Google Cloud > Auth Platform > Clients.
GOOGLE_OAUTH_REDIRECT_URI=
# Optional alternative to signing in on each browser.
GOOGLE_REFRESH_TOKEN=
# Alternative Google authentication: a service account shared as Sheet Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
APP_PASSWORD=
SESSION_SECRET=
